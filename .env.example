# doubt — API Keys
# All connectors work WITHOUT these keys using free public endpoints.
# Adding keys unlocks rate-limited or premium tiers.
#
# Instructions:
#   Copy this to .env and fill in your keys.
#   Keys are OPTIONAL unless marked REQUIRED.
#
# =============================================================

# ── LLM SYNTHESIS (optional — heuristic synthesis works without any LLM) ──
# Set one of these to enable deep synthesis. Anthropic is recommended.
# If neither is set, doubt falls back to local Ollama (llama3:latest).
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ── NEWS (recency mode — breaking news connectors) ──────────
# Brave Search: https://brave.com/search/api/ — Free: 2,000/month
BRAVE_SEARCH_KEY=

# GNews: https://gnews.io — Free: 100/day
GNEWS_API_KEY=

# Currents API: https://currentsapi.services — Free: 200/day
CURRENTS_API_KEY=

# SearXNG: run your own instance (faster, no rate limits)
# docker run -d -p 8080:8080 searxng/searxng
# Leave blank to use public fallback instances
SEARXNG_URL=

# ── SECURITY & OSINT ─────────────────────────────────────────
# AlienVault OTX: https://otx.alienvault.com — Free unlimited (community)
OTX_API_KEY=

# Intelligence X: https://intelx.io — Free: ~1,000 search units/month
INTELX_API_KEY=

# Shodan: https://shodan.io — Free: 100/month (academic: free)
SHODAN_API_KEY=

# ── GOVERNMENT & PROCUREMENT ─────────────────────────────────
# SAM.gov: https://sam.gov/content/home — Free (submit email for key)
# Without key: DEMO_KEY fallback (rate-limited but functional)
SAM_GOV_API_KEY=

# Congress.gov: https://api.congress.gov — Free
# Without key: DEMO_KEY fallback
CONGRESS_API_KEY=

# Companies House (UK): https://developer.company-information.service.gov.uk
# Free, unlimited
COMPANIES_HOUSE_API_KEY=

# ── MEDIA ────────────────────────────────────────────────────
# YouTube Data API v3: https://console.cloud.google.com — Free: 10,000 units/day
YOUTUBE_API_KEY=

# SerpAPI (Google Search): https://serpapi.com — Free: 100/month
SERPAPI_KEY=

# ── SYSTEM ───────────────────────────────────────────────────
# Set to 1 to disable filesystem cache (useful during development)
DOUBT_CACHE_DISABLED=
